<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Targit.Desktop.Views.MainWindow" Title="Targit" Width="1440" Height="900" MinWidth="900" MinHeight="600">
<DockPanel>
<Border DockPanel.Dock="Top" Background="#252526" Padding="10"><StackPanel Orientation="Horizontal" Spacing="16"><TextBlock Text="Targit" FontWeight="Bold"/><Button Content="Toggle repositories" Command="{Binding ToggleLeftCommand}"/><Button Content="Toggle inspector" Command="{Binding ToggleRightCommand}"/></StackPanel></Border>
<Border DockPanel.Dock="Top" Background="#252526" Padding="8"><StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="Repository" VerticalAlignment="Center"/><ComboBox Width="220" ItemsSource="{Binding Repositories}" SelectedItem="{Binding SelectedRepository}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBox Width="280" Watermark="Local repository path" Text="{Binding RepositoryPath}"/><Button Content="Open" Command="{Binding AddRepositoryCommand}"/><TextBlock Text="Branch:" VerticalAlignment="Center"/><TextBlock Text="{Binding CurrentBranch}" VerticalAlignment="Center"/></StackPanel></Border>
<Border DockPanel.Dock="Bottom" Background="#252526" Padding="7"><TextBlock Text="{Binding Status}"/></Border>
<Grid ColumnDefinitions="Auto,5,*,5,Auto">
<Border Grid.Column="0" Width="250" IsVisible="{Binding ShowLeftPanel}" Background="#252526" Padding="10"><StackPanel Spacing="12"><TextBlock Text="Repositories" FontWeight="Bold"/><ListBox ItemsSource="{Binding Repositories}" SelectedItem="{Binding SelectedRepository}"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}"/><TextBlock Text="{Binding Path}" FontSize="10" Foreground="#999999"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Text="Branches" FontWeight="Bold"/><TextBlock Text="Select a repository to browse branches" TextWrapping="Wrap" Foreground="#999999"/></StackPanel></Border>
<GridSplitter Grid.Column="1" Width="5" Background="#3F3F46" ResizeDirection="Columns"/>
<Border Grid.Column="2" Background="#1F1F1F" Padding="10"><DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6"><ComboBox Width="140" ItemsSource="{Binding AvailableTabs}" SelectedItem="{Binding NewTab}"/><Button Content="+ Tab" Command="{Binding AddTabCommand}"/><Button Content="Close tab" Command="{Binding CloseTabCommand}"/></StackPanel><TabControl ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}"/></DockPanel></Border>
<GridSplitter Grid.Column="3" Width="5" Background="#3F3F46" ResizeDirection="Columns"/>
<Border Grid.Column="4" Width="350" IsVisible="{Binding ShowRightPanel}" Background="#252526" Padding="10"><StackPanel Spacing="12"><TextBlock Text="Inspector" FontWeight="Bold"/><TextBlock Text="Repository details and contextual tools appear here." TextWrapping="Wrap" Foreground="#999999"/></StackPanel></Border>
</Grid></DockPanel></Window>