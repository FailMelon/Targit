<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:GitLlama.Desktop.Controls" x:Class="GitLlama.Desktop.Views.FileReviewView">
  <Grid RowDefinitions="Auto,Auto,*" Background="#1E1F22">
    <Border Background="#25282E" BorderBrush="#393E47" BorderThickness="0,0,0,1" Padding="12,8"><DockPanel><Button DockPanel.Dock="Right" Classes="workspace toolbar" Content="✕" Command="{Binding CloseFileReviewCommand}" ToolTip.Tip="Return to previous view"/><TextBlock Text="{Binding ReviewPath}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel></Border>
    <Border Grid.Row="1" Background="#25282E" BorderBrush="#393E47" BorderThickness="0,0,0,1" Padding="8,6"><WrapPanel ItemSpacing="6" LineSpacing="6"><Button Classes="workspace review-navigation" Content="← Back" Command="{Binding CloseFileReviewCommand}"/><Button Classes="workspace review-navigation" Content="File" Classes.active="{Binding IsFileMode}" Command="{Binding ReviewFileCommand}"/><Button Classes="workspace review-navigation" Content="Diff" Classes.active="{Binding IsDiffReview}" Command="{Binding ReviewDiffCommand}" IsVisible="{Binding CanReviewDiff}"/><Button Classes="workspace review-navigation" Content="History" Classes.active="{Binding IsHistoryMode}" Command="{Binding ReviewFileHistoryCommand}"/><Button Classes="workspace review-navigation" Content="Blame" Classes.active="{Binding IsBlameMode}" Command="{Binding ReviewFileBlameCommand}"/><CheckBox Content="Staged" IsChecked="{Binding ReviewStagedPatch}" IsVisible="{Binding IsWorkingDiffReview}" VerticalAlignment="Center"/><Border Width="1" Height="22" Background="#454B55" Margin="6,0" IsVisible="{Binding IsWorkingDiffReview}"/><Button x:Name="ApplyLineButton" Classes="workspace review-action" Content="{Binding ApplyLineLabel}" Command="{Binding ApplySelectedLineCommand}" IsVisible="{Binding IsWorkingDiffReview}"/><Button x:Name="ApplyHunkButton" Classes="workspace review-action" Classes.primary="{Binding CanApplySelectedHunk}" Content="{Binding ApplyHunkLabel}" Command="{Binding ApplySelectedHunkCommand}" IsVisible="{Binding IsWorkingDiffReview}"/></WrapPanel></Border>
    <Grid Grid.Row="2"><controls:PatchView FilePath="{Binding ReviewPath}" Patch="{Binding CenterPatch}" SelectedLine="{Binding SelectedPatchLine}" IsVisible="{Binding IsDiffReview}"/><controls:CodeView FilePath="{Binding ReviewPath}" Text="{Binding CenterContent}" IsVisible="{Binding IsContentReview}"/></Grid>
  </Grid>
</UserControl>
