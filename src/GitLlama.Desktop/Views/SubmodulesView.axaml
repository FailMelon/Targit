<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="GitLlama.Desktop.Views.SubmodulesView">
  <Grid Margin="12" RowDefinitions="Auto,*,Auto" RowSpacing="12"><TextBlock Text="Submodules" FontSize="18" FontWeight="SemiBold"/><ListBox Grid.Row="1" ItemsSource="{Binding Submodules}" SelectedItem="{Binding SelectedSubmodule}"/><StackPanel Grid.Row="2" Spacing="8"><TextBlock Text="{Binding SelectedSubmodule.Url}" Classes="muted" TextWrapping="Wrap"/><TextBlock Text="{Binding SelectedSubmodule.Commit}" Classes="muted" TextWrapping="Wrap"/><TextBlock Text="Initialize/update checks out the recorded commit. Dirty submodule work is protected; HTTPS credentials are scoped to the host configured in Remotes." Classes="muted" TextWrapping="Wrap"/><WrapPanel ItemSpacing="8"><Button Classes="workspace" Content="Initialize / update selected" Command="{Binding UpdateSubmoduleCommand}"/><Button Classes="workspace" Content="Cancel" Command="{Binding CancelNetworkCommand}" IsVisible="{Binding IsNetworkBusy}"/></WrapPanel><TextBlock Text="{Binding Status}" TextWrapping="Wrap"/></StackPanel></Grid>
</UserControl>
