<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:GitLlama.Desktop.Views"
             x:Class="GitLlama.Desktop.Views.NavigationView">
    <Border Background="{StaticResource SidebarBrush}"
            BorderBrush="#393E47"
            BorderThickness="1"
            CornerRadius="6">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="8" Spacing="3">
                <TextBox Watermark="Filter branches…"
                         Text="{Binding BranchSearch}"
                         Margin="0,0,0,8" />

                <Border Classes="category">
                    <Expander Classes="navigation"
                              Header="Local branches"
                              IsExpanded="True">
                        <StackPanel>
                            <ListBox Classes="branch-list"
                                     ItemsSource="{Binding LocalBranches}"
                                     SelectedItem="{Binding SelectedBranchLine, Mode=OneWay}"
                                     SelectionChanged="Branch_SelectionChanged"
                                     ContextRequested="BranchContextRequested"
                                     Tapped="Branch_Tapped"
                                     DoubleTapped="Branch_DoubleTapped"
                                     MaxHeight="230" />

                            <Button Classes="workspace toolbar"
                                    Content="＋ Create branch…"
                                    Click="CreateBranch_Click"
                                    HorizontalContentAlignment="Left" />
                        </StackPanel>
                    </Expander>
                </Border>

                <Border Classes="category">
                    <Expander Classes="navigation"
                              Header="Remotes"
                              IsExpanded="True">
                        <StackPanel>
                            <views:RemoteTreeView MaxHeight="300" />

                            <Button Classes="workspace toolbar"
                                    Content="Remote settings…"
                                    Click="Remotes_Click"
                                    HorizontalContentAlignment="Left" />
                        </StackPanel>
                    </Expander>
                </Border>

                <Border Classes="category">
                    <Expander Classes="navigation"
                              Header="Tags"
                              IsExpanded="False">
                        <StackPanel Spacing="4">
                            <ListBox ItemsSource="{Binding Tags}"
                                     SelectedItem="{Binding SelectedTag}"
                                     ContextRequested="TagContextRequested"
                                     MaxHeight="180">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Button Classes="workspace toolbar"
                                    Content="＋ Create tag…"
                                    Click="CreateTag_Click"
                                    HorizontalContentAlignment="Left" />

                            <Button Classes="workspace toolbar"
                                    Content="＋ Annotated tag…"
                                    Click="CreateAnnotatedTag_Click"
                                    HorizontalContentAlignment="Left" />
                        </StackPanel>
                    </Expander>
                </Border>

                <Border Classes="category">
                    <Expander Classes="navigation"
                              Header="Stashes"
                              IsExpanded="False">
                        <Button Classes="workspace toolbar"
                                Content="View stashes…"
                                Click="Stashes_Click"
                                HorizontalContentAlignment="Left" />
                    </Expander>
                </Border>

                <Border Classes="category">
                    <Expander Classes="navigation"
                              Header="Worktrees"
                              IsExpanded="False">
                        <Button Classes="workspace toolbar"
                                Content="View worktrees…"
                                Click="Worktrees_Click"
                                HorizontalContentAlignment="Left" />
                    </Expander>
                </Border>

                <Border Classes="category">
                    <Expander Classes="navigation"
                              Header="Pull requests"
                              IsExpanded="False">
                        <Button Classes="workspace toolbar"
                                Content="View pull requests…"
                                Click="PullRequests_Click"
                                HorizontalContentAlignment="Left" />
                    </Expander>
                </Border>

                <Border Classes="category">
                    <Expander Classes="navigation"
                              Header="Issues"
                              IsExpanded="False">
                        <Button Classes="workspace toolbar"
                                Content="View issues…"
                                Click="Issues_Click"
                                HorizontalContentAlignment="Left" />
                    </Expander>
                </Border>

                <Border Classes="category">
                    <Expander Classes="navigation" IsExpanded="True">
                        <Expander.Header>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Submodules" VerticalAlignment="Center" />

                                <Button x:Name="AddSubmoduleButton"
                                        Grid.Column="1"
                                        Classes="workspace toolbar"
                                        Content="＋"
                                        Click="AddSubmodule_Click"
                                        IsEnabled="{Binding HasRepository}"
                                        ToolTip.Tip="Add submodule"
                                        Padding="6,0"
                                        MinHeight="0" />
                            </Grid>
                        </Expander.Header>

                        <StackPanel>
                            <ListBox x:Name="SubmoduleList"
                                     ItemsSource="{Binding Submodules}"
                                     SelectedItem="{Binding SelectedSubmodule}"
                                     DoubleTapped="Submodule_DoubleTapped"
                                     ContextRequested="SubmoduleContextRequested"
                                     MaxHeight="220">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="20,*,Auto"
                                              ColumnSpacing="4"
                                              ToolTip.Tip="{Binding Path}">
                                            <Path Data="M 1,4 L 7,4 L 9,6 L 17,6 L 17,15 L 1,15 Z M 6,9 L 12,9 M 9,6.5 L 12,9 L 9,11.5"
                                                  Width="14"
                                                  Height="14"
                                                  Stretch="Uniform"
                                                  Stroke="#AAB2BF"
                                                  StrokeThickness="1.4"
                                                  VerticalAlignment="Center" />

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding DisplayName}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Summary}"
                                                       Classes="muted"
                                                       FontSize="11"
                                                       Margin="8,0,4,0"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="No submodules in this repository."
                                       Classes="muted"
                                       FontSize="11"
                                       Margin="8,4"
                                       IsVisible="{Binding !HasSubmodules}" />
                        </StackPanel>
                    </Expander>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
