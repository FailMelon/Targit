<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GitLlama.Desktop.Controls" x:Class="GitLlama.Desktop.Views.HistoryView">
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Background="{StaticResource SurfaceBrush}">
    <Grid Margin="8" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
      <ComboBox Width="145" ItemsSource="{Binding HistoryScopes}" SelectedItem="{Binding SelectedHistoryScope}"/>
      <TextBox x:Name="HistoryCommitSearch" Grid.Column="1" Watermark="Search commits (message, author, SHA, ref…)" Text="{Binding HistorySearch}"/>
      <Button Classes="workspace" Grid.Column="2" Content="Clear" Click="ClearSearch_Click" IsVisible="{Binding HasHistoryFilter}"/>
    </Grid>
    <StackPanel Grid.Row="1" Margin="8,0,8,6" Spacing="4">
      <Expander Header="Author and date filters"><WrapPanel ItemSpacing="8" LineSpacing="6" Margin="8"><TextBox Text="{Binding HistoryAuthorFilter}" Watermark="Author" Width="140"/><DatePicker SelectedDate="{Binding HistorySince}" ToolTip.Tip="Since date"/><DatePicker SelectedDate="{Binding HistoryUntil}" ToolTip.Tip="Until date"/></WrapPanel></Expander>
      <TextBlock Text="Filtered results · graph connections hidden" IsVisible="{Binding HasHistoryFilter}" Classes="muted" FontSize="11"/>
    </StackPanel>
    <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1" Padding="0,7" Background="#252526">
      <DockPanel><TextBlock DockPanel.Dock="Left" Text="Graph" Width="{Binding HistoryGraphWidth}" Padding="8,0"/><Grid ColumnDefinitions="*,135,112" Margin="8,0"><TextBlock Text="Message"/><TextBlock Grid.Column="1" Text="Author"/><TextBlock Grid.Column="2" Text="Date"/></Grid></DockPanel>
    </Border>
    <ListBox x:Name="HistoryList" Grid.Row="3" Classes="history" ItemsSource="{Binding HistoryRows}" SelectedItem="{Binding SelectedHistoryRow}" ContextRequested="CommitContextRequested">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Border BorderBrush="#2D2D30" BorderThickness="0,0,0,1" ToolTip.Tip="{Binding Sha}">
            <DockPanel Height="30">
              <controls:GraphCell DockPanel.Dock="Left" Width="{Binding GraphWidth}" Row="{Binding}"/>
              <Grid ColumnDefinitions="*,135,112" Margin="8,0" VerticalAlignment="Center">
                <DockPanel Margin="0,0,12,0">
                  <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Labels}" Margin="6,0,0,0" MaxWidth="200">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate><Border Background="#39313F" BorderBrush="#665274" BorderThickness="1" CornerRadius="3" Padding="5,2"><TextBlock Text="{Binding}" FontSize="10" TextTrimming="CharacterEllipsis" MaxWidth="120"/></Border></DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="{Binding Subject}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock Grid.Column="1" Text="{Binding Author}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" Classes="muted"/>
                <TextBlock Grid.Column="2" Text="{Binding Date}" FontSize="11" Classes="muted" ToolTip.Tip="{Binding FullDate}"/>
              </Grid>
            </DockPanel>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <StackPanel Grid.Row="3" IsVisible="{Binding HasNoHistory}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Margin="24">
      <TextBlock Text="⑂" FontSize="36" Classes="muted" HorizontalAlignment="Center"/>
      <TextBlock Text="{Binding HistoryEmptyMessage}" Classes="muted" TextWrapping="Wrap" HorizontalAlignment="Center"/>
      <Button Classes="workspace" Content="Open repository…" Click="OpenFolder_Click" HorizontalAlignment="Center" IsVisible="{Binding HasNoRepository}"/>
    </StackPanel>
    <Border Grid.Row="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,5"><DockPanel><Button DockPanel.Dock="Right" Classes="workspace" Content="Load more" Command="{Binding LoadMoreHistoryCommand}" IsVisible="{Binding HasMoreHistory}"/><TextBlock Text="{Binding HistoryCaption}" Classes="muted" FontSize="10" VerticalAlignment="Center"/></DockPanel></Border>
  </Grid>
</UserControl>
