<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:GitLlama.Desktop.Views" x:Class="GitLlama.Desktop.Views.RemotesView">
  <ScrollViewer><StackPanel Margin="16" Spacing="12">
    <TextBlock Text="Remotes" FontSize="18" FontWeight="SemiBold"/>
    <Border Classes="card"><StackPanel Spacing="8"><views:RemoteTreeView MaxHeight="320"/><TextBlock Text="Double-click a branch to check it out as a local tracking branch. Right-click a remote for actions." Classes="muted" TextWrapping="Wrap"/></StackPanel></Border>
    <TextBlock Text="{Binding SelectedRemote.Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedRemote.Url}" Classes="muted" TextWrapping="Wrap"/>
    <WrapPanel ItemSpacing="8" LineSpacing="8"><Button Classes="workspace" Content="Fetch" Command="{Binding FetchRemoteCommand}"/><Button Classes="workspace" Content="Pull (fast-forward)" Command="{Binding PullFastForwardCommand}"/><Button Classes="workspace" Content="Push current branch" Command="{Binding PushRemoteCommand}"/><Button Classes="workspace" Content="Cancel operation" Command="{Binding CancelNetworkCommand}" IsVisible="{Binding IsNetworkBusy}"/></WrapPanel>
    <TextBlock Text="{Binding NetworkProgressText}" Classes="muted"/>
    <Border Classes="card"><StackPanel Spacing="8"><TextBlock Text="Connection settings" Classes="section"/><TextBlock Text="{Binding NetworkCredentialHost}" Classes="muted"/><TextBlock Text="Manage accounts, HTTPS credentials and SSH keys in Settings." Classes="muted" TextWrapping="Wrap"/><Button Classes="workspace" Content="Open authentication settings" Click="AuthenticationSettings_Click" HorizontalAlignment="Left"/></StackPanel></Border>
    <Expander Header="Add or remove a remote"><StackPanel Margin="8" Spacing="8"><TextBox Text="{Binding NewRemoteName}" Watermark="Remote name"/><TextBox Text="{Binding NewRemoteUrl}" Watermark="Remote URL or local path"/><WrapPanel ItemSpacing="8"><Button Classes="workspace" Content="Add remote" Command="{Binding AddRemoteCommand}"/><Button Classes="workspace" Content="Remove selected remote" Command="{Binding RemoveRemoteCommand}"/></WrapPanel></StackPanel></Expander>
    <Border Classes="card"><StackPanel Spacing="8"><TextBlock Text="Branch tracking" Classes="section"/><TextBox Text="{Binding UpstreamBranchName}" Watermark="Remote branch to track (for example main)"/><WrapPanel ItemSpacing="8"><Button Classes="workspace" Content="Set upstream" Command="{Binding SetUpstreamCommand}"/><Button Classes="workspace" Content="Clear upstream" Command="{Binding ClearUpstreamCommand}"/></WrapPanel><TextBlock Text="{Binding UpstreamStatus}" Classes="muted"/></StackPanel></Border>
    <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
  </StackPanel></ScrollViewer>
</UserControl>
