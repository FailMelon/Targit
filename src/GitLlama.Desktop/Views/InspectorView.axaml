<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GitLlama.Desktop.Views.InspectorView">
    <Border Background="{StaticResource InspectorBrush}"
            BorderBrush="#393E47"
            BorderThickness="1"
            CornerRadius="6">
        <Grid>
            <ScrollViewer AllowAutoHide="False"
                          IsVisible="{Binding !IsWorkingTreeInspector}"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="16" Spacing="14">
                    <TextBlock Text="{Binding HistorySubject}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />

                    <Border Classes="card" IsVisible="{Binding HasHistoryMessage}">
                        <SelectableTextBlock Text="{Binding HistoryMessage}" TextWrapping="Wrap" />
                    </Border>

                    <Grid ColumnDefinitions="38,*" ColumnSpacing="12">
                        <Border Background="{Binding HistoryAvatar.Background, FallbackValue=#41434A}"
                                CornerRadius="18"
                                Width="36"
                                Height="36"
                                ClipToBounds="True"
                                VerticalAlignment="Top">
                            <Panel>
                                <TextBlock Text="{Binding HistoryAvatar.Initials, FallbackValue=●}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />

                                <Image Source="{Binding HistoryAvatar.Image}" Stretch="UniformToFill" />
                            </Panel>
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="{Binding HistoryAuthor}" />

                            <TextBlock Text="{Binding HistoryDate}"
                                       FontSize="11"
                                       Classes="muted" />

                            <SelectableTextBlock Text="{Binding HistorySha}"
                                                 FontSize="11"
                                                 Classes="muted" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Changed files" Classes="section" />

                    <ListBox Classes="file-list"
                             ItemsSource="{Binding HistoryFileRows}"
                             SelectedItem="{Binding SelectedHistoryFileRow}"
                             MaxHeight="300" />

                    <Expander Classes="navigation" Header="Commit metadata">
                        <SelectableTextBlock Text="{Binding HistoryCommitDetails}"
                                             TextWrapping="Wrap"
                                             Margin="0,8" />
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <Grid IsVisible="{Binding IsWorkingTreeInspector}" RowDefinitions="Auto,*,Auto">
                <Border BorderBrush="#393E47"
                        BorderThickness="0,0,0,1"
                        Padding="16,14">
                    <StackPanel Spacing="7">
                        <DockPanel>
                            <Border DockPanel.Dock="Right"
                                    Background="#404249"
                                    CornerRadius="5"
                                    Padding="8,3">
                                <TextBlock Text="{Binding ChangeCount}" Foreground="#DBDEE1" />
                            </Border>

                            <TextBlock Text="Commit changes"
                                       FontSize="20"
                                       FontWeight="SemiBold" />
                        </DockPanel>

                        <TextBlock Text="{Binding StagingSummary}" Classes="muted" />

                        <WrapPanel ItemSpacing="8">
                            <Button Classes="workspace toolbar"
                                    Content="✓ Stage all"
                                    Command="{Binding StageAllCommand}" />

                            <Button Classes="workspace toolbar"
                                    Content="Unstage all"
                                    Command="{Binding UnstageAllCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <ScrollViewer AllowAutoHide="False"
                              Grid.Row="1"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="8" Spacing="8">
                        <TextBlock Text="Everything is up to date."
                                   IsVisible="{Binding HasNoChanges}"
                                   Classes="muted"
                                   Margin="8,10" />

                        <Expander Classes="navigation"
                                  Header="{Binding StagedFilesCaption}"
                                  IsExpanded="True">
                            <ListBox Classes="file-list"
                                     ItemsSource="{Binding StagedFiles}"
                                     SelectedItem="{Binding SelectedStagedFile, Mode=OneWay}"
                                     SelectionChanged="StagedFile_SelectionChanged"
                                     ContextRequested="WorkingFileContextRequested"
                                     MaxHeight="300">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="26,30,*,Auto,20" ColumnSpacing="6">
                                            <CheckBox IsChecked="True"
                                                      Tag="unstage"
                                                      Click="StageCheckbox_Click"
                                                      ToolTip.Tip="Unstage this file"
                                                      VerticalAlignment="Center" />

                                            <Border Grid.Column="1"
                                                    Background="#454750"
                                                    CornerRadius="4"
                                                    Padding="3"
                                                    Width="27"
                                                    Height="26">
                                                <TextBlock Text="{Binding FileIcon}"
                                                           FontSize="10"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Path}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"
                                                       ToolTip.Tip="{Binding Path}" />


                                            <StackPanel Grid.Column="3"
                                                        Orientation="Horizontal"
                                                        Spacing="4">
                                            <Border Background="#2B3B50"
                                                    BorderBrush="#7F9FC9"
                                                    BorderThickness="1"
                                                    CornerRadius="3"
                                                    Padding="4,0"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding IsLfs}"
                                                    ToolTip.Tip="Stored in Git LFS">
                                                <TextBlock Text="LFS" FontSize="9" />
                                            </Border>

                                            <Path Data="M 3,7 L 3,4.5 A 3,3 0 0 1 9,4.5 L 9,7 M 1.5,7 L 10.5,7 L 10.5,13 L 1.5,13 Z"
                                                  Width="10"
                                                  Height="12"
                                                  Stretch="Uniform"
                                                  Stroke="{Binding LockColor}"
                                                  StrokeThickness="1.3"
                                                  VerticalAlignment="Center"
                                                  IsVisible="{Binding HasLock}"
                                                  ToolTip.Tip="{Binding LockToolTip}" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="4"
                                                       Text="{Binding StatusCode}"
                                                       Foreground="#76D999"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Expander>

                        <Border BorderBrush="#393E47" BorderThickness="0,1,0,0" />

                        <Expander Classes="navigation"
                                  Header="{Binding UnstagedFilesCaption}"
                                  IsExpanded="True">
                            <ListBox Classes="file-list"
                                     ItemsSource="{Binding UnstagedFiles}"
                                     SelectedItem="{Binding SelectedUnstagedFile, Mode=OneWay}"
                                     SelectionChanged="UnstagedFile_SelectionChanged"
                                     ContextRequested="WorkingFileContextRequested"
                                     MaxHeight="300">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="26,30,*,Auto,20" ColumnSpacing="6">
                                            <CheckBox IsChecked="False"
                                                      Tag="stage"
                                                      Click="StageCheckbox_Click"
                                                      ToolTip.Tip="Stage this file"
                                                      VerticalAlignment="Center" />

                                            <Border Grid.Column="1"
                                                    Background="#383A40"
                                                    CornerRadius="4"
                                                    Padding="3"
                                                    Width="27"
                                                    Height="26">
                                                <TextBlock Text="{Binding FileIcon}"
                                                           FontSize="10"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Path}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"
                                                       ToolTip.Tip="{Binding Path}" />


                                            <StackPanel Grid.Column="3"
                                                        Orientation="Horizontal"
                                                        Spacing="4">
                                            <Border Background="#2B3B50"
                                                    BorderBrush="#7F9FC9"
                                                    BorderThickness="1"
                                                    CornerRadius="3"
                                                    Padding="4,0"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding IsLfs}"
                                                    ToolTip.Tip="Stored in Git LFS">
                                                <TextBlock Text="LFS" FontSize="9" />
                                            </Border>

                                            <Path Data="M 3,7 L 3,4.5 A 3,3 0 0 1 9,4.5 L 9,7 M 1.5,7 L 10.5,7 L 10.5,13 L 1.5,13 Z"
                                                  Width="10"
                                                  Height="12"
                                                  Stretch="Uniform"
                                                  Stroke="{Binding LockColor}"
                                                  StrokeThickness="1.3"
                                                  VerticalAlignment="Center"
                                                  IsVisible="{Binding HasLock}"
                                                  ToolTip.Tip="{Binding LockToolTip}" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="4"
                                                       Text="{Binding StatusCode}"
                                                       Foreground="{Binding StatusColor}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Expander>

                        <Expander Classes="navigation"
                                  Header="Selected file actions"
                                  IsVisible="{Binding HasSelectedWorkingFile}">
                            <StackPanel Margin="8" Spacing="8">
                                <Button Classes="workspace"
                                        Content="Export patch…"
                                        Click="ExportPatch_Click"
                                        HorizontalAlignment="Left" />

                                <TextBlock Text="Discard restores staged content and loses unstaged edits."
                                           Classes="muted"
                                           TextWrapping="Wrap" />

                                <TextBox Text="{Binding DiscardConfirmation}" Watermark="Type DISCARD to confirm" />

                                <Button Classes="workspace"
                                        Content="Discard unstaged edits"
                                        Command="{Binding DiscardSelectedUnstagedCommand}" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2"
                        Background="#313338"
                        BorderBrush="#393E47"
                        BorderThickness="0,1,0,0"
                        Padding="14">
                    <StackPanel Spacing="9">
                        <StackPanel.Styles>
                            <Style Selector="RadioButton.mode-tab">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="#B5BAC1" />
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <ControlTemplate>
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="4"
                                                Padding="12,5">
                                            <ContentPresenter Content="{TemplateBinding Content}"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter>
                            </Style>

                            <Style Selector="RadioButton.mode-tab:pointerover">
                                <Setter Property="Background" Value="#383A40" />
                                <Setter Property="Foreground" Value="#DBDEE1" />
                            </Style>

                            <Style Selector="RadioButton.mode-tab:checked">
                                <Setter Property="Background" Value="#4E5058" />
                                <Setter Property="Foreground" Value="#F2F3F5" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Style>
                        </StackPanel.Styles>

                        <Border Background="#1E1F22"
                                CornerRadius="6"
                                Padding="3">
                            <UniformGrid Columns="2">
                                <RadioButton x:Name="CommitModeTab"
                                             Classes="mode-tab"
                                             Content="Commit"
                                             IsChecked="{Binding !IsStashMode, Mode=OneWay}" />

                                <RadioButton x:Name="StashModeTab"
                                             Classes="mode-tab"
                                             Content="Stash"
                                             IsChecked="{Binding IsStashMode}" />
                            </UniformGrid>
                        </Border>

                        <StackPanel Spacing="9" IsVisible="{Binding !IsStashMode}">
                            <TextBox Text="{Binding CommitSummaryText}" Watermark="Commit summary" />

                            <TextBox Text="{Binding CommitDescriptionText}"
                                     Watermark="Description (optional)"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Height="76" />

                            <CheckBox Content="Amend latest unpublished commit" IsChecked="{Binding AmendStagedCommit}" />
                        </StackPanel>

                        <StackPanel Spacing="9" IsVisible="{Binding IsStashMode}">
                            <TextBox Text="{Binding StashMessage}" Watermark="Stash message (optional)" />

                            <CheckBox Content="Include untracked files" IsChecked="{Binding StashIncludeUntracked}" />

                            <TextBlock Text="Sets aside all changes to tracked files, staged or not, and leaves a clean working tree. Ignored files are never stashed."
                                       Classes="muted"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Button Content="{Binding CommitButtonText}"
                                Command="{Binding CommitCommand}"
                                IsVisible="{Binding !IsStashMode}"
                                Classes="workspace primary"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                MinHeight="40" />

                        <Button Content="Stash changes"
                                Command="{Binding SaveTrackedStashCommand}"
                                IsVisible="{Binding IsStashMode}"
                                ToolTip.Tip="{Binding StashBlockedReason}"
                                ToolTip.ShowOnDisabled="True"
                                Classes="workspace primary"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                MinHeight="40" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
